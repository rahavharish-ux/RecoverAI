ENVIRONMENT=development
# Default is a local SQLite file — no setup needed. Point this at Postgres/
# Supabase instead only for a shared or production-like environment, using
# your own local credentials (never commit real ones):
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/recoverai
DATABASE_URL=sqlite:///./recoverai_dev.db
SUPABASE_URL=
SUPABASE_KEY=

# Optional. Leave unset to use the built-in Deterministic Decision Engine —
# the system is fully functional without this. Set it to enable the LLM
# ("Agentic AI Decision Engine") provider instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
