ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai
SUPABASE_URL=
SUPABASE_KEY=

# Optional. Leave unset to use the built-in Deterministic Decision Engine —
# the system is fully functional without this. Set it to enable the LLM
# ("Agentic AI Decision Engine") provider instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
